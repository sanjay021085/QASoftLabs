# ───────────────────────────────────────────────────────────────────
# QASoftLabs — Root .gitignore
# ───────────────────────────────────────────────────────────────────

# OS / Editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
!**/.env.example

# Node / Frontend
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
/coverage
/build
/dist
dist/
.cache/

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Misc tokens / credentials
*token.json*
*credentials.json*
*.pem

# Build artefacts
*.tsbuildinfo

# Deployment
.vercel
.netlify

# Internal platform / runtime
.emergent/
test_reports/
memory/test_credentials.md
dump.rdb

# Archives
**/*.zip
**/*.tar.gz
**/*.tgz
.env.*
*.env
credentials.json
*.key
.credentials
